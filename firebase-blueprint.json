{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private learner profile storing language preference and usage counts without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "ur", "roman-ur"]
        },
        "completedLessonsCount": {
          "type": "integer"
        },
        "questionsAskedCount": {
          "type": "integer"
        },
        "screenshotsAnalyzedCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "preferredLanguage",
        "completedLessonsCount",
        "questionsAskedCount",
        "screenshotsAnalyzedCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "LessonProgress": {
      "title": "LessonProgress",
      "description": "Tracks completion of a Digital Learning tutorial for an authenticated user.",
      "type": "object",
      "properties": {
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["lessonId", "userId", "completed", "completedAt"]
    },
    "SavedChatEntry": {
      "title": "SavedChatEntry",
      "description": "Saved step-by-step AI Saathi guidance for later offline or quick review.",
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "language": {
          "type": "string",
          "enum": ["en", "ur", "roman-ur"]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "steps": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["entryId", "userId", "language", "question", "summary", "steps", "createdAt"]
    },
    "HelpRequest": {
      "title": "HelpRequest",
      "description": "Volunteer help request logged by the user in the demo Volunteer Connect workflow.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "enum": ["en", "ur", "roman-ur"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "volunteerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "volunteerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "resolved", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestId",
        "userId",
        "topic",
        "language",
        "description",
        "volunteerId",
        "volunteerName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and personal activity counters."
    },
    "/users/{userId}/lessonProgress/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonProgress" },
      "description": "Owner-only tutorial completion records."
    },
    "/users/{userId}/chatHistory/{entryId}": {
      "schema": { "$ref": "#/entities/SavedChatEntry" },
      "description": "Owner-only saved AI Saathi step-by-step guides."
    },
    "/users/{userId}/helpRequests/{requestId}": {
      "schema": { "$ref": "#/entities/HelpRequest" },
      "description": "Owner-only volunteer help requests logged in the demo queue."
    }
  }
}
